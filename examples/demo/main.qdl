styles {
  tool_header {
    font_size: 16
  }
}

root qstd::vbox {
  spacing: 8
  paddings: 12
  color: "monet(SurfaceContainerLow)"

  node qstd::menubar {
    anchor: "top-fill"
    items: [
      {
        text: "File",
        items: [
          { text: "New Project", shortcut: "Ctrl+N", action: "FileNew" },
          { text: "Open...", shortcut: "Ctrl+O", action: "FileOpen" },
          {
            text: "Recent",
            items: [
              { text: "Nimbus Demo", action: "RecentDemo" },
              { text: "PurplePrint Graph", action: "RecentGraph" }
            ]
          },
          "-",
          { text: "Save", shortcut: "Ctrl+S", action: "FileSave" }
        ]
      },
      {
        text: "Edit",
        items: [
          { text: "Undo", shortcut: "Ctrl+Z", action: "EditUndo" },
          { text: "Redo", shortcut: "Ctrl+Y", action: "EditRedo" },
          "-",
          { text: "Preferences", action: "EditPrefs", disabled: true }
        ]
      },
      {
        text: "View",
        items: [
          { text: "Components", action: "ViewComponents" },
          { text: "PurplePrint", action: "ViewPurplePrint" },
          { text: "Gizmo", action: "ViewGizmo" },
          { text: "Dock", action: "ViewDock" },
          { text: "Timeline", action: "ViewTimeline" },
          { text: "Inspector", action: "ViewInspector" },
          { text: "Drag & Drop", action: "ViewDragDrop" }
        ]
      },
      {
        text: "Help",
        items: [
          { text: "About Nimbus", action: "HelpAbout" }
        ]
      }
    ]
    on_action: "OnMenuAction"
  }

  node qstd::hbox {
    spacing: 10
    color: "transparent"
    scrollable: true

    node qstd::choice "theme_palette" {
      tabs: ["Amber", "Ocean", "Forest", "Rose"]
      on_changed: "ChangePalette"
    }

    node qstd::choice "theme_mode" {
      tabs: ["Dark", "Light"]
      on_changed: "ChangeThemeMode"
    }

    node qstd::choice "theme_radius" {
      tabs: ["None", "Sharp", "Default", "Round"]
      tab_id: 2
      on_changed: "ChangeRadius"
    }

    node qstd::choice "theme_stroke" {
      tabs: ["Thin", "Default", "Bold"]
      tab_id: 1
      on_changed: "ChangeStroke"
    }

    node qstd::choice "theme_dpi" {
      tabs: ["Auto", "1.0x", "1.5x", "2.0x", "2.5x", "3.0x"]
      tab_id: 0
      on_changed: "ChangeDpi"
    }
  }

  node qstd::tabs "main_tabs" {
    tabs: ["Components", "PurplePrint", "Gizmo", "Dock", "Timeline", "Inspector", "Drag & Drop"]
    on_changed: "SwitchPage"
  }

  node qstd::hbox "page_components" {
    anchor: "fill"
    spacing: 10
    paddings: 4
    color: "transparent"

    node qstd::vbox {
      spacing: 10
      paddings: 16
      color: "monet(SurfaceContainer)"
      corner_radius: 16
      scrollable: true

      node qstd::text {
        style: "tool_header"
        text: "Nimbus Application"
        color: "monet(Primary)"
        font_size: 25
      }

      node qstd::radio {
        text: "Radio 1"
        checked: false
      }
      node qstd::radio {
        text: "Radio 2"
        checked: true
      }
        
      node qstd::check {
        text: "Check 1"
        checked: false
      }
      node qstd::check {
        text: "Check 2"
        checked: true
      }
      
      node qstd::switch {
        text: "Switch 1"
        checked: false
      }
      node qstd::switch {
        text: "Switch 2"
        checked: true
      }
      
      node qstd::button {
        text: "filled"
        variant: "filled"
      }
      node qstd::button {
        text: "tonal"
        variant: "tonal"
      }
      node qstd::button {
        text: "elevated"
        variant: "elevated"
      }
      node qstd::button {
        text: "outlined"
        variant: "outlined"
      }
    }

    node qstd::vbox {
      spacing: 10
      paddings: 16
      color: "monet(SurfaceContainer)"
      corner_radius: 16
      scrollable: true

      node qstd::edit {
        text: "Edit 1"
        title: "edit 1"
      }
      
      node qstd::combobox {
        title: "Render Backend"
        items: ["Vulkan", "OpenGL", "DirectX 12", "Metal"]
        selected: 0
      }

      node qstd::slider {
        value: 45
        min: 0
        max: 100
      }
      node qstd::interval {
        pos1: 25
        pos2: 75
        min: 0
        max: 100
      }

      node qstd::choice {
        tabs: ["cho1", "cho2", "cho3"]
      }
      node qstd::tabs {
        tabs: ["tab1", "tab2", "tab3"]
      }

      node qstd::popup {
        items: [
          "option 1",
          "-",
          {
            text: "others",
            items: [
              "other 1"
              "other 2"
              "other 3"
              "other 4"
            ],
          },
          
        ]
      }

      node qstd::tooltip {
        text: "a tooltip window"
        open: true
      }
    }

    node qstd::vbox {
      spacing: 10
      paddings: 16
      color: "monet(SurfaceContainer)"
      corner_radius: 16
      scrollable: true

      node qstd::spinbox {
        title: "Count"
        value: 10
        min: 0
        max: 100
        step: 5
        suffix: " pcs"
      }
    
      node qstd::floatspinbox {
        title: "Scale"
        value: 1.5
        min: 0.0
        max: 10.0
        step: 0.005
        decimals: 3
      }


      node qstd::progressbar {
        value: 30
        max: 100
      }
      node qstd::multiprogressbar {
        values: [40, 30, 20]
      }

      node qstd::collapsible {
        title: "Collapsible Section"
        expanded: true
        color: "monet(SurfaceContainerHigh)"
        header_color: "monet(SurfaceContainerHighest)"

        node qstd::spinner {}

        node qstd::text {
          text: "Hidden details inside collapsible"
        }
      }

      node qstd::button {
        text: "Open Wait Dialog"
        variant: "filled"
        on_click: "OpenWaitDialog"
      }

      node qstd::button {
        text: "Show Toast"
        variant: "tonal"
        on_click: "ShowToast"
      }
    }
  }

  node purpleprint::view "page_purpleprint" {
    anchor: "fill"
    visible: false

    node purpleprint::node "pp_var_a" {
      point: { x: 40, y: 40 }
      width: 170
      color: "oklch(0.78, 0.09, 250)"
      title: "variable: a"
      inputs: [{ name: "write", kind: "circle" }]
      outputs: [{ name: "value", kind: "circle" }]
    }

    node purpleprint::node "pp_event" {
      point: { x: 40, y: 155 }
      width: 170
      color: "oklch(0.675, 0.138, 65)"
      title: "event: tick"
      outputs: [
        { name: "exec", kind: "flow" },
        { name: "active", kind: "diamond" }
      ]
    }

    node purpleprint::node "pp_const_b" {
      point: { x: 40, y: 285 }
      width: 170
      color: "oklch(0.62, 0.08, 300)"
      title: "const: b"
      outputs: [
        { name: "value", kind: "circle" },
        { name: "items", kind: "array" }
      ]
    }

    node purpleprint::node "pp_add" {
      point: { x: 330, y: 110 }
      width: 220
      color: "oklch(0.78, 0.11, 160)"
      title: "add"
      inputs: [
        { name: "exec", kind: "flow" },
        { name: "v1", kind: "circle" },
        { name: "v2", kind: "circle" }
      ]
      outputs: [
        { name: "next", kind: "flow" },
        { name: "res", kind: "circle" }
      ]
    }

    node purpleprint::node "pp_output" {
      point: { x: 610, y: 140 }
      width: 190
      color: "oklch(0.72, 0.12, 30)"
      title: "output"
      inputs: [
        { name: "exec", kind: "flow" },
        { name: "value", kind: "circle" },
        { name: "meta", kind: "square" },
        { name: "list", kind: "array" }
      ]
    }
  }

  node qstd::vbox "page_gizmo" {
    anchor: "fill"
    visible: false
    spacing: 8
    color: "transparent"

    node qstd::hbox {
      spacing: 12
      paddings: 10
      color: "monet(SurfaceContainer)"
      corner_radius: 12

      node qstd::choice {
        tabs: ["Translate", "Rotate", "Scale"]
        on_changed: "GizmoMode"
      }

      node qstd::choice {
        tabs: ["World", "Local"]
        on_changed: "GizmoSpace"
      }

      node qstd::check {
        text: "Snap"
        checked: false
        on_changed: "GizmoSnap"
      }

      node qstd::button {
        text: "Reset"
        variant: "tonal"
        on_click: "GizmoReset"
      }
    }

    node qstd::stack {
      anchor: "fill"
      paddings: 12
      color: "monet(SurfaceContainer)"
      corner_radius: 16

      node gizmo::transform "demo_transform_gizmo" {
        anchor: "fill"
        mode: "translate"
        space: "world"
        on_changed: "GizmoTransformChanged"
      }

      node gizmo::orientation "demo_orientation_gizmo" {
        anchor: "right-top"
        size: 96
        margin: 8
        on_snap: "GizmoCameraSnap"
        on_orbit: "GizmoCameraOrbit"
      }

      node qstd::text "gizmo_info" {
        anchor: "left-bottom"
        text: "Pos: (0.00, 0.00, 0.00)  |  Scale: (1.00, 1.00, 1.00)"
        font_size: 13
      }
    }
  }

  node dock::area "page_dock" {
    anchor: "fill"
    visible: false
    on_pane_closed: "OnDockPaneClosed"

    node dock::pane {
      title: "Viewport"
      slot: "center"
      closable: false

      node qstd::vbox {
        anchor: "fill"
        spacing: 8
        paddings: 12
        color: "transparent"

        node qstd::text {
          text: "3D Viewport"
          color: "monet(Primary)"
          font_size: 18
        }
        node qstd::text {
          text: "Drag any tab onto the center or edges of another panel to re-dock, or drag splitters to resize."
          font_size: 13
        }
      }
    }

    node dock::pane {
      title: "Assets"
      slot: "center"

      node qstd::vbox {
        anchor: "fill"
        spacing: 6
        paddings: 4
        color: "transparent"

        node qstd::text { text: "textures/albedo.png" }
        node qstd::text { text: "shaders/pbr.wgsl" }
        node qstd::text { text: "scenes/main.qdl" }
      }
    }

    node dock::pane {
      title: "Scene"
      slot: "left"

      node qstd::treeview {
        anchor: "fill"
        draggable: true
        items: [
          {
            text: "World",
            expanded: true,
            badge: "Root",
            items: [
              { text: "Main Camera", badge: "Cam", color: "monet(Primary)" },
              { text: "Sun Light", badge: "Light", color: "oklch(0.82, 0.14, 85)" },
              {
                text: "Player",
                expanded: true,
                badge: "Actor",
                items: [
                  { text: "Body Mesh", badge: "Mesh" },
                  { text: "Collider", badge: "Phys" }
                ]
              },
              { text: "Terrain", badge: "Mesh" }
            ]
          }
        ]
      }
    }

    node dock::pane {
      title: "Inspector"
      slot: "right"

      node qstd::vbox {
        anchor: "fill"
        spacing: 8
        paddings: 4
        color: "transparent"

        node qstd::edit {
          title: "Name"
          text: "Player Mesh"
        }
        node qstd::switch {
          text: "Cast Shadows"
          checked: true
        }
        node qstd::slider {
          value: 60
          min: 0
          max: 100
        }
      }
    }

    node dock::pane {
      title: "Console"
      slot: "bottom"

      node qstd::vbox {
        anchor: "fill"
        spacing: 4
        paddings: 4
        color: "transparent"

        node qstd::text { text: "[INFO] Nimbus DockArea initialized." font_size: 13 }
        node qstd::text { text: "[INFO] Vulkan RHI ready." font_size: 13 }
      }
    }
  }

  node qstd::vbox "page_timeline" {
    anchor: "fill"
    visible: false
    spacing: 8
    color: "transparent"

    node qstd::hbox {
      spacing: 12
      paddings: 8
      color: "monet(SurfaceContainer)"
      corner_radius: 12

      node qstd::button "tl_play_btn" {
        text: "Play"
        variant: "filled"
        on_click: "TimelineTogglePlay"
      }

      node qstd::button {
        text: "Stop"
        variant: "tonal"
        on_click: "TimelineStop"
      }

      node qstd::check {
        text: "Snap (30fps)"
        checked: true
        on_changed: "TimelineSnap"
      }

      node qstd::text "tl_readout" {
        anchor: "center"
        text: "t = 0.00s  |  Pos X: 0.00  |  Pos Y: 0.00"
        font_size: 13
      }
    }

    node timeline::view "demo_timeline" {
      anchor: "top-fill"
      duration: 6.0
      fps: 30.0
      snap: true
      on_time_changed: "TimelineTimeChanged"
      on_keyframe_changed: "TimelineKeyframeChanged"
    }

    node timeline::curve "demo_curve" {
      anchor: "fill"
      time_min: 0.0
      time_max: 6.0
      value_min: -1.5
      value_max: 1.5
      on_curve_changed: "TimelineCurveChanged"
    }
  }

  node qstd::hbox "page_inspector" {
    anchor: "fill"
    visible: false
    spacing: 12
    paddings: 4
    color: "transparent"

    node qstd::vbox {
      spacing: 12
      paddings: 16
      color: "monet(SurfaceContainer)"
      corner_radius: 16
      scrollable: true

      node qstd::text {
        text: "Transform & Vectors"
        color: "monet(Primary)"
        font_size: 18
      }

      node qstd::text {
        text: "UV Tiling"
        font_size: 13
      }
      node inspector::vec2 {
        value: [1.0, 1.0]
        default: [1.0, 1.0]
      }

      node qstd::text {
        text: "Velocity"
        font_size: 13
      }
      node inspector::vec3 {
        value: [0.0, 9.81, 0.0]
        suffix: "m/s"
      }

      node qstd::text {
        text: "Shader Tint"
        font_size: 13
      }
      node inspector::vec4 {
        value: [1.0, 0.85, 0.60, 1.0]
        default: [1.0, 1.0, 1.0, 1.0]
        min: 0.0
        max: 1.0
      }
    }
  }

  node qstd::hbox "page_dnd" {
    anchor: "fill"
    visible: false
    spacing: 12
    paddings: 4
    color: "transparent"

    node qstd::vbox {
      spacing: 10
      paddings: 16
      color: "monet(SurfaceContainer)"
      corner_radius: 16
      scrollable: true

      node qstd::text {
        text: "Draggable Assets"
        color: "monet(Primary)"
        font_size: 18
      }

      node qstd::text {
        text: "Drag any item into the drop zones on the right. Press Esc to cancel."
        color: "monet(OnSurfaceVariant)"
        font_size: 12
      }

      node qstd::drag_source {
        text: "PBR_Metal.glsl"
        badge: "Shader"
        kind: "nimbus/shader"
        color: "#e85d63"
      }

      node qstd::drag_source {
        text: "Water_Ripple.glsl"
        badge: "Shader"
        kind: "nimbus/shader"
        color: "#e85d63"
      }

      node qstd::drag_source {
        text: "Hero_Character.glb"
        badge: "Mesh"
        kind: "nimbus/mesh"
        color: "#47c770"
      }

      node qstd::drag_source {
        text: "Ambient_Loop.ogg"
        badge: "Audio"
        kind: "nimbus/audio"
        color: "#5299f5"
      }

      node qstd::drag_source {
        text: "Studio_HDRI.exr"
        badge: "Texture"
        kind: "nimbus/texture"
        color: "#b875f2"
      }

      node qstd::button {
        text: "Clear Drop Zones"
        variant: "outlined"
        on_click: "DndClearZones"
      }
    }

    node qstd::vbox {
      anchor: "fill"
      spacing: 12
      paddings: 16
      color: "monet(SurfaceContainer)"
      corner_radius: 16
      scrollable: true

      node qstd::text {
        text: "Drop Targets"
        color: "monet(Primary)"
        font_size: 18
      }

      node qstd::drop_zone "dnd_zone_shader" {
        title: "Shader Slot"
        hint: "Only accepts Shader items"
        accept: "nimbus/shader"
        effect: "copy"
        on_drop: "OnDndDrop"
      }

      node qstd::drop_zone "dnd_zone_any" {
        title: "Scene Asset Bin"
        hint: "Accepts any asset or external OS file"
        accept: "*"
        effect: "move"
        on_drop: "OnDndDrop"
      }

      node qstd::drop_zone "dnd_zone_files" {
        title: "OS File Drop"
        hint: "Drag files from your desktop / file manager here"
        accept: "os/files"
        effect: "copy"
        on_drop: "OnDndDrop"
      }
    }
  }
}
